# Copy this file to .env and adjust as needed. Every value has a working
# default in config/settings.py, so .env is optional for local development.

SECRET_KEY=django-insecure-dev-key-change-me-before-deploying
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_NAME=db.sqlite3
TIME_ZONE=UTC
LOG_LEVEL=INFO

# Computer vision / face recognition tuning (see README "Engineering Challenge")
CV_DATA_DIR=data
CV_MIN_FACE_SIZE=60
CV_SAMPLES_PER_STUDENT=20
CV_RECOGNITION_DISTANCE_THRESHOLD=75.0
CV_CONSECUTIVE_MATCHES_REQUIRED=3
CV_BLUR_VARIANCE_THRESHOLD=40.0
CV_CAMERA_INDEX=0
